# Dependencies — rebuildable from package.json / package-lock.json, never commit these
node_modules/

# macOS Finder cruft
.DS_Store

# Python bytecode — regenerated by every test run, so committing it makes
# `git status` permanently dirty and invites `git add -A` to sweep it in
__pycache__/
*.pyc

# Harness-created git worktrees — scratch checkouts of this same repo
.claude/worktrees/

# Subagent-driven-development scratch — ledgers, briefs, review packages
.superpowers/
